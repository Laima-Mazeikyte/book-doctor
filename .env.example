# Vite-only fallback if PUBLIC_* are unset in some tooling (optional).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase client-side (for anonymous auth in the browser; PUBLIC_ is used by SvelteKit)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# The frontend uses no server-only secrets. The service-role key and the recommendation / feed /
# goodreads webhook handlers live in the separate backend service (and Supabase webhook config).

# Bunny.net pull zone base URL for book cover images (e.g. https://your-pullzone.b-cdn.net). Covers are loaded as {base}/{book_id}.avif
PUBLIC_BUNNY_COVERS_BASE=

# Hosted lab artifacts are loaded from read-only, versioned trees in public Supabase Storage.
# Point BASE at the public bucket prefix
# (https://<ref>.supabase.co/storage/v1/object/public/<bucket>/<project-prefix>) and pin VERSION
# to the approved release; leaving VERSION unset makes the frontend read current_release.json.

# Author connections — public Supabase Storage release prefix.
PUBLIC_AUTHOR_FRONTEND_BASE=
PUBLIC_AUTHOR_FRONTEND_VERSION=

# Supabase Edge Function answering arbitrary two-author comparisons, used by Compare mode.
# Defaults to 'compare-authors' when unset. Reader memberships stay server-side: the function
# is the only route to them, and the `private` schema must never be queried from a browser.
PUBLIC_AUTHOR_COMPARISON_FUNCTION=

# Author prominence — public Supabase Storage release. There is no local artifact fallback.
PUBLIC_AUTHOR_PROMINENCE_BASE=https://obkbdcbvxyenfecdbvsz.supabase.co/storage/v1/object/public/author-prominence
PUBLIC_AUTHOR_PROMINENCE_VERSION=v3

# Book search — temp/best_book_search, served at /best-book-search-local while the release is local.
# Set these to the public storage prefix and release version when the handoff is deployed.
PUBLIC_BOOK_RANKINGS_BASE=
PUBLIC_BOOK_RANKINGS_VERSION=

# Maintenance mode. Set PUBLIC_MAINTENANCE_MODE=true and redeploy to take the site down for
# maintenance: only the landing page (/) and FAQ (/faq) stay up; everything else returns 503.
# PUBLIC_MAINTENANCE_UNTIL is an absolute ISO 8601 UTC timestamp that drives the countdown timer.
PUBLIC_MAINTENANCE_MODE=false
PUBLIC_MAINTENANCE_UNTIL=
